# Generare password e token distinti: openssl rand -hex 32
POSTGRES_PASSWORD=CAMBIA_POSTGRES_PASSWORD
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CAMBIA_PASSWORD_DASHBOARD
ZABBIX_WEBHOOK_TOKEN=CAMBIA_TOKEN_WEBHOOK
# Lettura Zabbix CPU (opzionale, solo su ai-control; token diverso dal webhook)
# Endpoint HTTPS, es. https://zabbix.example.com/zabbix/api_jsonrpc.php
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
# Item CPU totale: default sceglie CPU utilization o 100-idle; se necessario specificare key_ esatta
ZABBIX_CPU_ITEM_KEY=
# Analisi access.log automatica ogni ora, ultimi 10 minuti
HOURLY_ACCESS_ENABLED=true
# Analisi log applicativi delle ultime 24h, ogni ora; false per disattivare
HOURLY_APP_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TZ=Europe/Rome
NIGHTLY_HOUR=2
NIGHTLY_MINUTE=30
MAIL_HOUR=6
MAIL_MINUTE=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_TO=
SMTP_STARTTLS=true
MAX_AI_INPUT_CHARS=27000
DATA_RETENTION_DAYS=30
